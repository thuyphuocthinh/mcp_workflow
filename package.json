{
  "name": "mcp-workflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"MCP,BACKEND,FRONTEND\" -c \"blue,green,magenta\" \"npm run dev:mcp\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:mcp": "cd mcp_servers && npm run dev",
    "dev:backend": "cd backend && npm start",
    "dev:frontend": "cd frontend && npm run dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.2",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.53.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
