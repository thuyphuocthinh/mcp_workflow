      "https://www.googleapis.com/auth/calendar",
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },
  "tools": [
    {
      "name": "list_events",
      "description": "List upcoming calendar events"
    },
    {
      "name": "create_event",
      "description": "Create a new calendar event"
    },
    {
      "name": "delete_event",
      "description": "Delete a calendar event"
    }
  ]
}

