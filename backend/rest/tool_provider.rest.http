### =========================
### Create Google Docs Tool
### =========================
POST {{baseUrl}}/tools
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "google_docs",
  "name": "Google Docs",
  "description": "Interact with Google Docs documents",
  "endpoint": "https://docs.googleapis.com/v1",
  "transport": "http",
  "enabled": true,
  "auth": {
    "type": "oauth",
    "provider": "google",
    "scopes": [
      "https://www.googleapis.com/auth/documents",
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "tools": [
    {
      "name": "create_document",
      "description": "Create a new Google Docs document"
    },
    {
      "name": "read_document",
      "description": "Read content of a Google Docs document"
    }
  ]
}

