### =========================
### Create Gmail Tool
### =========================
POST {{baseUrl}}/tools
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "gmail",
  "name": "Gmail",
  "description": "Send and read emails via Gmail API",
  "endpoint": "https://gmail.googleapis.com/gmail/v1",
  "transport": "http",
  "enabled": true,
  "auth": {
    "type": "oauth",
    "provider": "google",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/gmail.send"
    ]
  },
  "tools": [
    {
      "name": "send_email",
      "description": "Send an email via Gmail"
    },
    {
      "name": "read_inbox",
      "description": "Read inbox messages"
    }
  ]
}

