Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "google_calendar",
  "name": "Google Calendar",
  "description": "Manage events and schedules using Google Calendar API",
  "endpoint": "https://www.googleapis.com/calendar/v3",
  "transport": "http",
  "enabled": true,
  "auth": {
    "type": "oauth",
    "provider": "google",
